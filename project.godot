; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Road of Nogg"
run/main_scene="res://scenes/Battle25D.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/textures/icon.png"

[display]

; UI renders 1:1 at whatever the window actually is; nothing here resamples
; the canvas. `NoggTheme.UI_SCALE` (src/presentation/theme/NoggTheme.gd) is
; the resolution-aware scale instead, applied to design-unit tokens rather
; than to the canvas — see docs/UI_DESIGN.md §3. `canvas_items` + fractional
; stretch, the previous setting, scaled the whole canvas by a fraction at
; nearly every real window size, which under nearest filtering desynced pixel
; fonts and small-integer UI geometry mid-word.
window/stretch/mode="disabled"

[filesystem]

import/blender/enabled=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/lossless_compression/force_png=true
textures/webp_compression/compression_method=0
textures/webp_compression/lossless_compression_factor=0.0
textures/default_filters/anisotropic_filtering_level=0
textures/decals/filter=0
textures/light_projectors/filter=0
