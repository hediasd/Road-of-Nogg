#!/bin/sh
# Runs the fast `unit` test tier before allowing a commit.
# Install once with scripts/install_hooks.ps1 (sets core.hooksPath).
# Bypass intentionally with: git commit --no-verify

repo_root="$(git rev-parse --show-toplevel)"
godot_exe="$repo_root/Godot_v4.4-stable_win64.exe"

if [ ! -f "$godot_exe" ]; then
	echo "pre-commit: Godot binary not found at $godot_exe — skipping unit tests." >&2
	exit 0
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/run_godot_check.ps1" \
	-Script res://tests/run_tests.gd \
	-ScriptArgs unit \
	-ExpectedMarker TESTS_OK \
	-TimeoutSeconds 30 \
	-QuitAfter 30 \
	-LogStem pre_commit_unit
status=$?

if [ $status -ne 0 ]; then
	echo "" >&2
	echo "pre-commit: unit tests failed (see failing test names and log path above)." >&2
	echo "pre-commit: bypass intentionally with 'git commit --no-verify'." >&2
	exit 1
fi

exit 0
