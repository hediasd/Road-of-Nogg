# Godot
.godot/
.import/
*.tmp
*.import~*

# Blender
*.blend1
*.blend2

# Crocotile
*.crocotile

# System
.DS_Store
thumbs.db

# IDE
.vscode/
.idea/
.claude/worktrees/

# Generated diagnostics
/debug/
builds/
godot_final.txt
test_out.txt

# Godot executable (don't commit engine)
Godot_v*.exe
Godot_v*.x86_64

# Battle outputs: logs, records, championship corpora. Every writer goes through
# battle/BattleOutputPaths.gd. Only the .gdignore marker is tracked.
/battle_output/*
!/battle_output/.gdignore

# Generated runtime logs
godot_out.txt
godot_test*.txt

# Exported gameplay scenes under scenes/generated/ ARE committed: the battle cannot show its ground
# without them, and ignoring them let a folder move lose them silently. Rebuild them with
# tools/export_battle_scenes.gd; probe_battle_scene_parity checks the committed copies.
