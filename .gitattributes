# Authored text: keep LF regardless of the checkout platform.
*.gd text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gdshader text eol=lf

# Common asset formats: never treated as text, even when the underlying
# format happens to be JSON or XML (glTF, Collada).
*.png binary
*.ttf binary
*.TTF binary
*.otf binary
*.blend binary
*.gltf binary
*.dae binary
*.mtl binary
*.material binary
