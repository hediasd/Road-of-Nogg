# Authored text: keep LF regardless of the checkout platform.
*.gd text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.gdshader text eol=lf

# Append-only ledgers: concatenate both sides instead of conflicting when a
# side branch lands. Duplicates are cheaper to prune than a blocked merge.
BACKLOG_CRITICAL.md merge=union
BACKLOG_LONGTERM.md merge=union

# Common asset formats: never treated as text, even when the underlying
# format happens to be JSON or XML (glTF, Collada).
*.png binary
*.ttf binary
*.TTF binary
*.otf binary
*.blend binary
*.gltf binary
*.dae binary
*.mtl binary
*.material binary
